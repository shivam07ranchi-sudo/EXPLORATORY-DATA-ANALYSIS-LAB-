      "source": [
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "from scipy import stats\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = pd.read_csv(\"https://raw.githubusercontent.com/salemprakash/EDA/main/Data/data.csv\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "8aa09929"
      },
      "source": [
        "price = df['price'].loc[df['price'] != '?']\n",
        "pmean = price.astype(float).mean()\n",
        "df['price'] = df['price'].replace('?', pmean).astype(int)\n",
        "display(df['price'].head())"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "944b1732"
      },
      "source": [
        "horsepower = df['horsepower'].loc[df['horsepower'] != '?']\n",
        "hpmean = horsepower.astype(float).mean()\n",
        "df['horsepower'] = df['horsepower'].replace('?', hpmean).astype(int)\n",
        "display(df['horsepower'].head())"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "f81fa818"
      },
      "source": [
        "normalized_losses_series = df['normalized-losses'].loc[df['normalized-losses'] != '?']\n",
        "nl_mean = normalized_losses_series.astype(float).mean()\n",
        "df['normalized-losses'] = df['normalized-losses'].replace('?', nl_mean).astype(int)\n",
        "display(df['normalized-losses'].head())"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "52db69c2"
      },
      "source": [
        "display(df.dtypes)"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "0e40563e"
      },
      "source": [
        "corr = stats.pearsonr(df[\"price\"], df[\"horsepower\"])\n",
        "print(\"p-value:\\t\", corr[1])\n",
        "print(\"cor:\\t\\t\", corr[0])"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "6a24a1b8"
      },
      "source": [
        "correlation = df.corr(method='pearson', numeric_only=True)\n",
        "display(correlation)"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "d1d68028"
      },
      "source": [
        "plt.figure(figsize=(10, 8))\n",
        "sns.heatmap(correlation, xticklabels=correlation.columns, yticklabels=correlation.columns, annot=True, cmap='coolwarm', fmt=\".2f\")\n",
        "plt.title('Correlation Matrix of Numerical Features')\n",
        "plt.show()"
      ],
