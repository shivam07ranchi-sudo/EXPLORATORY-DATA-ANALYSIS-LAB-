        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.preprocessing import MinMaxScaler, StandardScaler, RobustScaler"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "c2dc74bc"
      },
      "source": [
        "data = {\n",
        "    'Age': [25, 30, 45, 35, 22],\n",
        "    'Salary': [50000, 64000, 120000, 85000, 1200000]\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "print(\"Original Data:\\n\", df, \"\\n\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "ec6d4dc5"
      },
      "source": [
        "min_max_scaler = MinMaxScaler()\n",
        "df_min_max = pd.DataFrame(\n",
        "    min_max_scaler.fit_transform(df),\n",
        "    columns=df.columns\n",
        ")\n",
        "print(\"Min-Max Scaled Data:\\n\", df_min_max, \"\\n\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "eff0d7e2"
      },
      "source": [
        "standard_scaler = StandardScaler()\n",
        "df_standard = pd.DataFrame(\n",
        "    standard_scaler.fit_transform(df),\n",
        "    columns=df.columns\n",
        ")\n",
        "print(\"Standardized Data:\\n\", df_standard, \"\\n\")"
      ],
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "333039cf"
      },
      "source": [
        "robust_scaler = RobustScaler()\n",
        "df_robust = pd.DataFrame(\n",
        "    robust_scaler.fit_transform(df),\n",
        "    columns=df.columns\n",
        ")\n",
        "print(\"Robust Scaled Data:\\n\", df_robust, \"\\n\")"
      ],
      "execution_count": null,
      "outputs": []
    },
